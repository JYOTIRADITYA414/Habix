# Generate a private value with: python -c "import secrets; print(secrets.token_hex(32))"
HABIX_SECRET_KEY=

# Optional: defaults to instance/habix.sqlite3
# HABIX_DATABASE=instance/habix.sqlite3

# Optional: use PostgreSQL instead of SQLite (required for Vercel deployments)
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Keep debug off for normal use. This app binds to localhost by default.
HABIX_DEBUG=0

# Use 1 only when serving over HTTPS. Leave 0 for local http://127.0.0.1.
HABIX_COOKIE_SECURE=0
